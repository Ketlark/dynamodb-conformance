<script webc:setup>
  function band(v) {
    if (v == null) return "none";
    if (v >= 95) return "pass";
    if (v >= 75) return "partial";
    return "fail";
  }
  function barClass(v) { return "bar-" + band(v); }
  function widthPct(v) { return (v == null ? 0 : v) + "%"; }
</script>
<a
  :href="'/targets/' + row.slug"
  :class="'group block rounded-xl border p-5 transition-colors ' + (row.synthesised ? 'bg-brand-50 dark:bg-brand-500/10 border-brand-200 dark:border-brand-500/30' : 'bg-zinc-50/70 dark:bg-white/[0.03] border-zinc-200 dark:border-white/10 hover:border-brand-300 dark:hover:border-brand-500/40')">
  <div class="flex items-center justify-between gap-3 mb-3">
    <span class="font-semibold text-zinc-900 dark:text-zinc-50 group-hover:text-brand-700 dark:group-hover:text-brand-300 truncate" @text="row.display"></span>
    <span webc:if="row.synthesised" class="text-xs text-brand-700 dark:text-brand-300 font-medium shrink-0">ground truth</span>
    <span webc:elseif="row.movement.state === 'new'" class="shrink-0 inline-flex items-center rounded-full bg-brand-100 dark:bg-brand-500/20 px-2 py-0.5 text-xs font-medium text-brand-700 dark:text-brand-200">new</span>
    <span webc:elseif="row.movement.state === 'carried'" class="text-xs text-zinc-500 dark:text-zinc-400 shrink-0" aria-hidden="true">–</span>
    <span webc:else :class="'shrink-0 inline-flex items-center gap-1 text-xs font-medium tnum move-' + row.movement.state">
      <span aria-hidden="true" @text="row.movement.arrow"></span>
      <span @text="row.movement.deltaLabel"></span>
      <span class="sr-only" @text="row.movement.label"></span>
    </span>
  </div>
  <div class="flex items-center gap-3">
    <div
      class="flex-1 h-2.5 rounded-full bg-zinc-200 dark:bg-white/10 overflow-hidden"
      role="meter"
      aria-valuemin="0"
      aria-valuemax="100"
      :aria-valuenow="row.totalValue == null ? 0 : row.totalValue"
      :aria-label="row.display + ' total conformance: ' + row.total">
      <div class="h-full rounded-full" :class="barClass(row.totalValue)" :style="'width:' + widthPct(row.totalValue)"></div>
    </div>
    <span class="w-14 text-right font-mono font-bold tnum text-zinc-900 dark:text-zinc-100" @text="row.total"></span>
  </div>
  <div class="mt-2 text-xs font-mono text-zinc-500 dark:text-zinc-400 truncate" :title="row.version" @text="row.version"></div>
</a>
