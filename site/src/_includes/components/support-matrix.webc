<script webc:setup>
  function glyph(s) { return ({ supported: "✓", partial: "◑", failing: "✗", unsupported: "–" })[s] || "·"; }
  function cellClass(s) {
    return ({
      supported: "text-pass-700 dark:text-pass-400",
      partial: "text-partial-700 dark:text-partial-400",
      failing: "text-fail-700 dark:text-fail-400",
      unsupported: "text-zinc-500 dark:text-zinc-400",
    })[s] || "text-zinc-300 dark:text-zinc-700";
  }
  function stateLabel(s) {
    return ({
      supported: "supported",
      partial: "partially supported",
      failing: "failing",
      unsupported: "unsupported",
    })[s] || "not tested";
  }
  // The non-zero pass/fail/skip parts, so a cell's tooltip can say why it's
  // partial ("62 pass, 4 fail") rather than just naming the state.
  function cellCounts(item) {
    const parts = [];
    if (item.passed) parts.push(item.passed + " pass");
    if (item.failed) parts.push(item.failed + " fail");
    if (item.skipped) parts.push(item.skipped + " skip");
    return parts.join(", ");
  }
  function cellDescribe(item) {
    const counts = cellCounts(item);
    return item.display + " " + item.group + ": " + stateLabel(item.state) + (counts ? " (" + counts + ")" : "");
  }
</script>
<!-- Both axes are capped to what they hold, and the wrapper hugs the result
     rather than stretching it. Left uncapped, the target columns split the whole
     row and drifted a glyph's width apart; capping only those handed the slack
     to the operation name, which needs 160px and was getting 288px. A table
     narrower than its container is the honest outcome here, and better than one
     padded out to fill a width its contents do not need. -->
<div class="overflow-x-auto w-fit max-w-full rounded-xl border border-zinc-200 dark:border-white/10">
  <div
    class="grid text-sm"
    :style="'grid-template-columns: minmax(150px, 12rem) repeat(' + (matrix.ncols - 1) + ', 7rem)'">
    <template webc:for="item of matrix.items" webc:nokeep>
      <div webc:if="item.type === 'corner'" class="sticky left-0 z-20 bg-white dark:bg-surface-950 border-b border-zinc-200 dark:border-white/10 px-3 py-3 font-medium text-zinc-500 dark:text-zinc-400">Operation</div>
      <!-- Columns are sized so the longest target name sits on one line; a
           two-line heading made the row taller for every column to suit one of
           them. The version is a 12-character sha often enough that it truncates
           instead, with the full value on hover. -->
      <a webc:elseif="item.type === 'col'" :href="'/targets/' + item.slug" class="min-w-0 border-b border-zinc-200 dark:border-white/10 px-2 py-3 self-end text-center text-xs font-medium text-zinc-600 dark:text-zinc-300 hover:text-brand-700 dark:hover:text-brand-300">
        <span class="block leading-tight whitespace-nowrap" @text="item.display"></span>
        <span class="block truncate font-mono text-[0.65rem] font-normal text-zinc-500 dark:text-zinc-400" :title="item.version" @text="item.version"></span>
      </a>
      <div webc:elseif="item.type === 'tier'" class="bg-zinc-50 dark:bg-white/[0.04] text-xs uppercase tracking-wide font-semibold text-zinc-500 dark:text-zinc-400" style="grid-column: 1 / -1">
        <span class="sticky left-0 inline-block px-3 py-2" @text="item.label"></span>
      </div>
      <div webc:elseif="item.type === 'rowhead'" class="sticky left-0 z-10 bg-white dark:bg-surface-950 border-t border-zinc-100 dark:border-white/5 px-3 py-2 whitespace-nowrap">
        <span class="font-mono text-zinc-700 dark:text-zinc-300" @text="item.group"></span>
        <span webc:if="item.qualifier" class="ml-1.5 text-[0.65rem] uppercase tracking-wide text-zinc-500 dark:text-zinc-400" @text="item.qualifier"></span>
      </div>
      <div webc:else class="border-t border-zinc-100 dark:border-white/5 px-2 py-2 text-center">
        <span :class="'text-base font-bold ' + cellClass(item.state)" :title="cellDescribe(item)" aria-hidden="true" @text="glyph(item.state)"></span>
        <span class="sr-only" @text="cellDescribe(item)"></span>
      </div>
    </template>
  </div>
</div>
