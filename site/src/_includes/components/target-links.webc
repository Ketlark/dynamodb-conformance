<!--
  A target's project site and its source, each shown as its own URL.

  Both are external, so each carries the outward arrow and the new-tab warning
  in its label - the convention the standings row deliberately doesn't borrow
  for its internal link. Icons distinguish the two at a glance, but the URL
  carries the meaning: an icon alone can't tell a reader whether a link leads
  to the project or to a page about it.

  A plain root, not webc:root="override": that override merges the host's
  attributes onto this element, which renders the props as stray attributes.
-->
<div webc:if="links.website || links.source" class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-sm">
  <a webc:if="links.website"
    :href="links.website.url"
    target="_blank"
    rel="noopener noreferrer"
    class="group inline-flex items-center gap-1.5 min-w-0 max-w-full text-zinc-600 dark:text-zinc-300 hover:text-brand-700 dark:hover:text-brand-300 transition-colors rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:focus-visible:outline-brand-400"
    :aria-label="name + ' website, ' + links.website.label + ' (opens in a new tab)'">
    <svg class="w-4 h-4 shrink-0 text-zinc-400 group-hover:text-brand-600 dark:group-hover:text-brand-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18zm0 0c2.5-2.4 3.75-5.4 3.75-9S14.5 5.4 12 3m0 18c-2.5-2.4-3.75-5.4-3.75-9S9.5 5.4 12 3M3.6 9h16.8M3.6 15h16.8" /></svg>
    <span class="font-mono truncate" @text="links.website.label"></span>
    <svg class="w-3 h-3 shrink-0 text-zinc-400 group-hover:text-brand-600 dark:group-hover:text-brand-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7m0 0H8m9 0v9" /></svg>
  </a>

  <a webc:if="links.source"
    :href="links.source.url"
    target="_blank"
    rel="noopener noreferrer"
    class="group inline-flex items-center gap-1.5 min-w-0 max-w-full text-zinc-600 dark:text-zinc-300 hover:text-brand-700 dark:hover:text-brand-300 transition-colors rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:focus-visible:outline-brand-400"
    :aria-label="name + ' source, ' + links.source.label + ' (opens in a new tab)'">
    <!-- The host's own mark where we have one, so the source is recognisable
         before the URL is read. Angle brackets stand in for anywhere else,
         until that host earns its own mark. -->
    <svg webc:if="links.source.host === 'github.com'" class="w-4 h-4 shrink-0 text-zinc-400 group-hover:text-brand-600 dark:group-hover:text-brand-300 transition-colors" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg>
    <svg webc:else class="w-4 h-4 shrink-0 text-zinc-400 group-hover:text-brand-600 dark:group-hover:text-brand-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25M6.75 17.25L1.5 12l5.25-5.25M14.25 3.75l-4.5 16.5" /></svg>
    <span class="font-mono truncate" @text="links.source.label"></span>
    <svg class="w-3 h-3 shrink-0 text-zinc-400 group-hover:text-brand-600 dark:group-hover:text-brand-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7m0 0H8m9 0v9" /></svg>
  </a>
</div>
