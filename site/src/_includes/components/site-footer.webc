<footer class="border-t border-zinc-200 dark:border-white/10 mt-auto">
  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex flex-wrap justify-center sm:justify-start items-center gap-x-6 gap-y-2 text-sm text-zinc-500 dark:text-zinc-400">
        <a href="/runs" class="hover:text-brand-700 dark:hover:text-brand-300 transition-colors">Runs</a>
        <a href="/methodology" class="hover:text-brand-700 dark:hover:text-brand-300 transition-colors">Methodology</a>
        <a href="/for-agents" class="hover:text-brand-700 dark:hover:text-brand-300 transition-colors">For agents</a>
        <a href="/changelog" class="hover:text-brand-700 dark:hover:text-brand-300 transition-colors">Changelog</a>
        <a href="https://github.com/paritysuite/dynamodb-conformance" target="_blank" rel="noopener noreferrer" class="hover:text-brand-700 dark:hover:text-brand-300 transition-colors">Conformance suite</a>
        <a href="/privacy" class="hover:text-brand-700 dark:hover:text-brand-300 transition-colors">Privacy</a>
      </div>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        Built by <a href="https://martinhicks.dev" rel="author" class="text-zinc-700 dark:text-zinc-300 hover:text-brand-600 dark:hover:text-brand-300 transition-colors">Martin Hicks</a>
      </p>
    </div>
    <script webc:type="render" webc:is="template">
      function () {
        return `<p class="mt-6 text-xs text-zinc-500 dark:text-zinc-400 text-center sm:text-left">
          &copy; ${new Date().getFullYear()} Martin Hicks &middot; Every figure on this site is derived at build time from the conformance suite's results, never hand-authored.
        </p>`;
      }
    </script>
    <p class="mt-3 text-xs text-zinc-500 dark:text-zinc-400 text-center sm:text-left">
      Last updated
      <a :href="'/runs/' + $data.conformance.latest.id" class="hover:text-zinc-700 dark:hover:text-zinc-300"><time :datetime="$data.conformance.latest.date" @text="dateLabel($data.conformance.latest.date)"></time></a>.
      <span webc:if="$data.conformance.source !== 'remote'" class="text-partial-700 dark:text-partial-400">Showing the last committed snapshot, which may be behind the latest run.</span>
      <a href="/feed.xml" class="hover:text-zinc-700 dark:hover:text-zinc-300">Runs feed</a>,
      <a href="/for-agents" class="hover:text-zinc-700 dark:hover:text-zinc-300">results as data</a>.
    </p>
    <p class="mt-3 text-xs leading-relaxed text-zinc-500 dark:text-zinc-400 text-center sm:text-left">
      Amazon DynamoDB, DynamoDB and AWS are trademarks of Amazon.com, Inc. or its affiliates. This is an
