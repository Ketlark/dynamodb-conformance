---js
{
  layout: "layouts/base.webc",
  meta: {
    title: "Targets",
    description: "Every DynamoDB target the conformance suite tracks, with its current score and a link to its full history.",
  },
  // The cards show each target's latest-run score, so freshness tracks the data,
  // not this file's git date. Keeps the sitemap <lastmod> honest.
  eleventyComputed: {
    lastmod: (data) => data.conformance?.latest?.date,
  },
}
---
<section class="max-w-6xl mx-auto px-6 py-12">
  <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-white mb-2">Targets</h1>
  <p class="text-zinc-600 dark:text-zinc-300 mb-8 max-w-2xl">
    Every target the suite tracks, with its score from the latest run. Open one to see its tier breakdown and how its conformance has moved over time.
  </p>
  <div class="grid sm:grid-cols-2 gap-4">
    <target-card
      webc:for="slug of $data.conformance.targets"
      :row="$data.conformance.perTarget[slug].current"></target-card>
  </div>

  <suggest-target></suggest-target>
</section>
