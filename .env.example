# Point at any DynamoDB-compatible endpoint.
# Omit to use real DynamoDB (requires AWS credentials).
DYNAMODB_ENDPOINT=http://localhost:8000

# AWS region (default: us-east-1)
AWS_REGION=us-east-1

# For most local endpoints, any values work.
AWS_ACCESS_KEY_ID=fakeAccessKeyId
AWS_SECRET_ACCESS_KEY=fakeSecretAccessKey

# ExtendDB is the exception: it mandates TLS and verifies SigV4, so it needs a
# real access key plus the self-signed cert trusted via NODE_EXTRA_CA_CERTS.
# The JS SDK does NOT read AWS_CA_BUNDLE. Keep placeholders here, never a real
# key (this file is committed). Real credentials go in .env, which is gitignored.
# DYNAMODB_ENDPOINT=https://127.0.0.1:8000
# NODE_EXTRA_CA_CERTS=/Users/you/.extenddb/tls/cert.pem
# AWS_ACCESS_KEY_ID=YOUR_EXTENDDB_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=YOUR_EXTENDDB_SECRET_ACCESS_KEY
